{
  "name": "sonic-collective",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro build && tsx scripts/validate-build.ts && node scripts/validate-output.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "content:validate": "tsx scripts/validate-content.ts",
    "youtube:sync": "tsx scripts/sync-youtube.ts",
    "youtube:hydrate": "tsx scripts/hydrate-youtube-snapshot.ts",
    "validate:output": "tsx scripts/validate-build.ts",
    "output:validate": "node scripts/validate-output.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astro": "7.4.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
