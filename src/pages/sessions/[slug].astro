---
import PerformancePage from '../../components/PerformancePage.astro';
import {getDiscoveryCatalog} from '../../lib/discovery';
export async function getStaticPaths(){const catalog=await getDiscoveryCatalog();return catalog.performances.map(item=>({params:{slug:item.id},props:{performanceId:item.id}}));}
const catalog=await getDiscoveryCatalog();
---
<PerformancePage catalog={catalog} performanceId={Astro.props.performanceId} />
