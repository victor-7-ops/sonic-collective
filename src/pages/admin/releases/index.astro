---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import {readEditorialForm} from '../../../lib/editorial/access';
import {prepareEditorialRelease} from '../../../lib/editorial/release-server';
import {mfaRequirementUnmet} from '../../../lib/editorial/mfa';
import {readLiveRelease,releaseStatus} from '../../../lib/editorial/release-marker';
import {fetchProductionBuilds,redeployProduction,summarizeBuilds} from '../../../lib/editorial/deployments';
import {latestLiveChoice,previouslyLive} from '../../../lib/editorial/live-release';
import {isReleaseId} from '../../../lib/editorial/release-build';
export const prerender=false;
const member=Astro.locals.editorialMember!;
if(member.role==='contributor') return new Response('Only active editors and owners can prepare release snapshots.',{status:403});
const client=Astro.locals.editorialClient!;
let message='';
let requestId:string=globalThis.crypto.randomUUID();
const deploymentConfig={token:process.env.VERCEL_API_TOKEN,projectId:process.env.DEPLOYMENTS_PROJECT_ID,teamId:process.env.DEPLOYMENTS_TEAM_ID};
if(Astro.request.method==='POST') {
  try {
    const form=await readEditorialForm(Astro.request);
    if(form.get('action')==='go-live') {
      if(member.role!=='owner') throw new Error('Only an owner can make a release live.');
      const target=form.get('releaseId')??'';
      if(!isReleaseId(target)) throw new Error('Reload the release page and try again.');
      if(await mfaRequirementUnmet(client)) throw new Error('Verify your authenticator in Account before changing the live release.');
      const chosen=await client.rpc('set_editorial_live_release',{p_release_id:target});
      if(chosen.error) throw new Error('The release could not be chosen. Check that you are an active owner and that the release exists.');
      const redeploy=await redeployProduction(deploymentConfig);
      return Astro.redirect(`/admin/releases/?chosen=${target}&redeploy=${redeploy.ok?'started':'failed'}`,303);
    }
    const submittedRequestId=form.get('requestId')??'';
    if(form.get('action')!=='prepare'||!/^[a-f\d-]{36}$/i.test(submittedRequestId)) throw new Error('Reload the release page and try again.');
    requestId=submittedRequestId;
    const unmet=await mfaRequirementUnmet(client);
    if(unmet) throw new Error('Verify your authenticator in Account before preparing a release.');
    const releaseId=await prepareEditorialRelease(client,requestId);
    return Astro.redirect(`/admin/releases/?prepared=${releaseId}`,303);
  } catch(reason) {
    message=reason instanceof Error?reason.message:'The release could not be prepared.';
    Astro.response.status=400;
  }
}
const releases=await client.from('editorial_releases').select('id,created_at').order('created_at',{ascending:false}).limit(50);
if(releases.error) Astro.response.status=503;
const prepared=Astro.url.searchParams.get('prepared');
const live=await readLiveRelease(Astro.url.origin);
const chosenParam=Astro.url.searchParams.get('chosen');
let choice=null;let choiceError=false;
try { choice=await latestLiveChoice(client); } catch { choiceError=true; }
const choiceHistory=await client.from('editorial_live_releases').select('release_id,set_at').order('id',{ascending:false}).limit(50);
const wasLive=previouslyLive(choiceHistory.data??[],live.state==='release'?live.marker.releaseId:null);
const buildSummary=summarizeBuilds(await fetchProductionBuilds(deploymentConfig),live.state==='unknown'?null:live.marker.commit);
---
<EditorialLayout title="Release snapshots" description="Create an immutable snapshot of the currently approved editorial content.">
  <p class="notice">Preparing a snapshot does not publish or deploy the site. A release goes live only when the production build is pointed at it (CMS_RELEASE_ID) and redeployed.</p>
  <p role="status"><strong>Live now:</strong> {live.state==='release'?<>release <code>{live.marker.releaseId}</code> <small>(built {new Date(live.marker.builtAt).toISOString().replace('T',' ').slice(0,16)} UTC)</small></>:live.state==='repository'?<>repository content, no CMS release <small>(built {new Date(live.marker.builtAt).toISOString().replace('T',' ').slice(0,16)} UTC)</small></>:<>unknown — the site did not report a release marker</>}</p>
  <section class="panel" aria-labelledby="production-builds"><h2 id="production-builds">Production builds</h2>
    <p class:list={['notice',buildSummary.kind==='failed'&&'error']} role={buildSummary.kind==='failed'?'alert':'status'}>{buildSummary.headline}</p>
    {buildSummary.builds.length>0&&<div class="table-scroll"><table><thead><tr><th scope="col">Started</th><th scope="col">Result</th><th scope="col">Commit</th><th scope="col">Message</th></tr></thead><tbody>{buildSummary.builds.map(build=><tr><td><time datetime={build.createdAt}>{build.createdAt.replace('T',' ').slice(0,16)} UTC</time></td><td>{build.state}</td><td><code>{build.commit?.slice(0,7)??'—'}</code></td><td>{build.inspectorUrl?<a href={build.inspectorUrl} target="_blank" rel="noopener noreferrer">{build.message||'Build details'}</a>:build.message}</td></tr>)}</tbody></table></div>}
  </section>
  {chosenParam&&<p class={'notice'+(Astro.url.searchParams.get('redeploy')==='failed'?' error':'')} role="status">{Astro.url.searchParams.get('redeploy')==='started'?'Release chosen. A production build has started; progress appears under Production builds. Reload in a minute.':'Release chosen, but the production build could not be started automatically. Redeploy the latest production build in Vercel to apply it.'}</p>}
  {!choiceError&&choice&&<p><strong>Chosen to go live:</strong> release <code>{choice.releaseId}</code> <small>({live.state==='release'&&live.marker.releaseId===choice.releaseId?'built and live':'waiting for a production build to finish'})</small></p>}
  {prepared&&<p class="notice" role="status">Release snapshot prepared. Download the validated artifact below.</p>}
  {message&&<p class="notice error" role="alert">{message} <a href="/admin/security/">Account security</a></p>}
  <section class="panel" aria-labelledby="prepare-release"><h2 id="prepare-release">Prepare approved snapshot</h2>
    <p>The system rechecks every approved revision and reference before it records an immutable snapshot. If your account uses an authenticator, verify it first.</p>
    <form method="post"><input type="hidden" name="action" value="prepare" /><input type="hidden" name="requestId" value={requestId} /><button>Prepare release snapshot</button></form>
  </section>
  <section class="panel" aria-labelledby="release-history"><h2 id="release-history">Recent snapshots</h2>
    {releases.error?<p class="notice error" role="alert">Release history could not be loaded.</p>:releases.data.length===0?<p>No release snapshots have been prepared.</p>:<div class="table-scroll"><table><thead><tr><th scope="col">Release ID</th><th scope="col">Prepared</th><th scope="col">Status</th><th scope="col">Artifact</th>{member.role==='owner'&&<th scope="col">Go live</th>}</tr></thead><tbody>{releases.data.map(release=><tr><td><code>{release.id}</code></td><td><time datetime={release.created_at}>{new Date(release.created_at).toISOString().replace('T',' ').slice(0,16)} UTC</time></td><td>{releaseStatus(release.id,undefined,live)==='live'?'Live':(wasLive.has(release.id)?`Previously live (${wasLive.get(release.id)!.slice(0,10)})`:'Prepared, not live')}</td><td><a href={`/admin/releases/${release.id}.json/`}>Download validated JSON</a></td>{member.role==='owner'&&<td>{releaseStatus(release.id,undefined,live)==='live'?<small>Already live</small>:<form method="post" onsubmit="return confirm('Make this release live? Production will rebuild from it.')"><input type="hidden" name="action" value="go-live" /><input type="hidden" name="releaseId" value={release.id} /><button class="secondary">Make live</button></form>}</td>}</tr>)}</tbody></table></div>}
  </section>
</EditorialLayout>

