---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import {readEditorialForm} from '../../../lib/editorial/access';
import {prepareEditorialRelease} from '../../../lib/editorial/release-server';
import {mfaRequirementUnmet} from '../../../lib/editorial/mfa';
export const prerender=false;
const member=Astro.locals.editorialMember!;
if(member.role==='contributor') return new Response('Only active editors and owners can prepare release snapshots.',{status:403});
const client=Astro.locals.editorialClient!;
let message='';
let requestId:string=globalThis.crypto.randomUUID();
if(Astro.request.method==='POST') {
  try {
    const form=await readEditorialForm(Astro.request);
    const submittedRequestId=form.get('requestId')??'';
    if(form.get('action')!=='prepare'||!/^[a-f\d-]{36}$/i.test(submittedRequestId)) throw new Error('Reload the release page and try again.');
    requestId=submittedRequestId;
    const unmet=await mfaRequirementUnmet(client);
    if(unmet) throw new Error('Verify your authenticator in Account before preparing a release.');
    const releaseId=await prepareEditorialRelease(client,requestId);
    return Astro.redirect(`/admin/releases/?prepared=${releaseId}`,303);
  } catch(reason) {
    message=reason instanceof Error?reason.message:'The release could not be prepared.';
    Astro.response.status=400;
  }
}
const releases=await client.from('editorial_releases').select('id,created_at').order('created_at',{ascending:false}).limit(50);
if(releases.error) Astro.response.status=503;
const prepared=Astro.url.searchParams.get('prepared');
---
<EditorialLayout title="Release snapshots" description="Create an immutable snapshot of the currently approved editorial content.">
  <p class="notice">Preparing a snapshot does not publish or deploy the site. Deployment remains a separate, unconnected step.</p>
  {prepared&&<p class="notice" role="status">Release snapshot prepared. Download the validated artifact below.</p>}
  {message&&<p class="notice error" role="alert">{message} <a href="/admin/security/">Account security</a></p>}
  <section class="panel" aria-labelledby="prepare-release"><h2 id="prepare-release">Prepare approved snapshot</h2>
    <p>The system rechecks every approved revision and reference before it records an immutable snapshot. If your account uses an authenticator, verify it first.</p>
    <form method="post"><input type="hidden" name="action" value="prepare" /><input type="hidden" name="requestId" value={requestId} /><button>Prepare release snapshot</button></form>
  </section>
  <section class="panel" aria-labelledby="release-history"><h2 id="release-history">Recent snapshots</h2>
    {releases.error?<p class="notice error" role="alert">Release history could not be loaded.</p>:releases.data.length===0?<p>No release snapshots have been prepared.</p>:<div class="table-scroll"><table><thead><tr><th scope="col">Release ID</th><th scope="col">Prepared</th><th scope="col">Artifact</th></tr></thead><tbody>{releases.data.map(release=><tr><td><code>{release.id}</code></td><td><time datetime={release.created_at}>{new Date(release.created_at).toISOString().replace('T',' ').slice(0,16)} UTC</time></td><td><a href={`/admin/releases/${release.id}.json/`}>Download validated JSON</a></td></tr>)}</tbody></table></div>}
  </section>
</EditorialLayout>

