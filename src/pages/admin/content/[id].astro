---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialPicker from '../../../components/EditorialPicker.astro';
import CommunityPicksFields from '../../../components/CommunityPicksFields.astro';
import SiteSettingsFields from '../../../components/SiteSettingsFields.astro';
import { readEditorialForm } from '../../../lib/editorial/access';
import { editorialKindSchema,editorialKindLabels,editorialStatusLabels } from '../../../lib/editorial/content';
import { editorialFields,editorialPickerOptions } from '../../../lib/editorial/forms';
import { applyContentAction } from '../../../lib/editorial/actions';
import { historyPage,historyPageSize,loadRevisionHistory } from '../../../lib/editorial/history';
import { fullTargetIds,loadPerformanceVideoIds,loadReviewRows } from '../../../lib/editorial/inbox';
import type { SiteConfig } from '../../../lib/schemas';
import { homepagePerformanceOptions,homepageTeaserOptions,resolveSiteContent } from '../../../lib/editorial/site-content';
export const prerender=false;
const client=Astro.locals.editorialClient!;
const id=Astro.params.id??'';
if(!/^[a-f\d-]{36}$/i.test(id)) return new Response('Content not found.',{status:404});
const itemResult=await client.from('content_items').select('*').eq('id',id).maybeSingle();
if(itemResult.error) return new Response('Content could not be loaded.',{status:503});
if(!itemResult.data) return new Response('Content not found.',{status:404});
const item=itemResult.data;
const kind=editorialKindSchema.parse(item.kind);
if(!item.draft_revision_id) return new Response('This content does not have a saved revision yet.',{status:503});
const revisionResult=await client.from('content_revisions').select('payload').eq('id',item.draft_revision_id).single();
if(revisionResult.error) return new Response('The current revision could not be loaded.',{status:503});
let payload=revisionResult.data.payload as Record<string,unknown>;
let message='';let conflict=false;
let fullChoices:string[]=[];
if(kind==='youtube-review') {
  const [reviews,performanceIds]=await Promise.all([loadReviewRows(client),loadPerformanceVideoIds(client)]);
  if(!reviews||!performanceIds) return new Response('Video references could not be loaded.',{status:503});
  fullChoices=fullTargetIds(performanceIds,reviews).filter(videoId=>videoId!==item.stable_id);
}
if(Astro.request.method==='POST') {
  try {
    const result=await applyContentAction(client,item,kind,payload,await readEditorialForm(Astro.request),{fullYoutubeIds:fullChoices});
    if('redirect' in result) return Astro.redirect(result.redirect,303);
    payload=result.payload;message=result.message;conflict=result.status===409;
    Astro.response.status=result.status;
  } catch {message='The form could not be read. Reload and try again.';Astro.response.status=400;}
}
const related=await client.from('content_items').select('stable_id,kind,draft_revision_id').in('kind',['artist','performance']).order('stable_id');
if(related.error) return new Response('Content references could not be loaded.',{status:503});
const options=(target:string)=>(related.data??[]).filter(row=>row.kind===target).map(row=>({id:row.stable_id,label:row.stable_id}));
const strings=(key:string)=>Array.isArray(payload[key])?payload[key] as string[]:[];
const isArchived=item.archived_at!==null;
const hasFields=(editorialFields[kind].length>0||kind==='site')&&!isArchived;
const canReview=Astro.locals.editorialMember!.role!=='contributor';
const canManageArchive=canReview;
const historyNumber=historyPage(Astro.url.searchParams.get('history'));
const history=await loadRevisionHistory(client,id,historyNumber);
const siteCopy=kind==='site'?resolveSiteContent(payload as SiteConfig):undefined;
const siteHero=kind==='site'&&payload.hero&&typeof payload.hero==='object'?payload.hero as Record<string,unknown>:undefined;
const selectedHeroId=typeof siteHero?.performanceId==='string'?siteHero.performanceId:'';
const selectedClipId=typeof siteHero?.portraitClipId==='string'?siteHero.portraitClipId:'';
const heroOptions=editorialPickerOptions(selectedHeroId?[selectedHeroId]:[],homepagePerformanceOptions);
const teaserOptions=editorialPickerOptions(selectedClipId?[selectedClipId]:[],homepageTeaserOptions);
---
<EditorialLayout title={String(payload.name??payload.title??item.stable_id)} description="Make your edit, save a private draft, then send it for review.">
  <p><span class="status-badge" data-state={item.review_state}>{editorialStatusLabels[item.review_state]??item.review_state}</span> <small> · {editorialKindLabels[kind]} · Revision {item.version}</small></p>
  {isArchived?<p class="notice">Archived content is read-only and excluded from active references.</p>:<p class="notice">Draft only. Approval records an editorial decision; publishing is not connected yet.</p>}
  {Astro.url.searchParams.has('archived')&&<p role="status">Content archived.</p>}
  {Astro.url.searchParams.has('unarchived')&&<p role="status">Content restored to the active library as a private record.</p>}
  {canManageArchive&&<form method="post" data-archive-confirm={isArchived?'Restore this record to the active library? It will remain private.':'Archive this record? It will be removed from active references.'}>
    <input type="hidden" name="action" value={isArchived?'unarchive':'archive'} /><input type="hidden" name="version" value={item.version} />
    <button class={isArchived?'secondary':''}>{isArchived?'Restore to active library':'Archive record'}</button>
  </form>}
  {kind==='site'&&<p><a href={`/preview/${id}/?revision=${item.draft_revision_id}`} target="_blank" rel="noopener">Preview homepage revision {item.version} ↗</a> · <a href={`/preview/${id}/?revision=${item.draft_revision_id}&view=about`} target="_blank" rel="noopener">Preview About page ↗</a></p>}
  {['artist','performance'].includes(kind)&&<p><a href={`/preview/${id}/?revision=${item.draft_revision_id}`} target="_blank" rel="noopener">Preview saved revision {item.version} ↗</a> <small>Opens privately in a new tab. Other links show the published site.</small></p>}
  {Astro.url.searchParams.has('saved')&&<p role="status">Draft saved.</p>}
  {message&&<p class="notice error" role="alert">{message}</p>}
  {isArchived?<p>This record cannot be edited, reviewed, or restored from history while archived.</p>:hasFields?<form method="post" data-editorial-form>
    <input type="hidden" name="action" value="save" /><input type="hidden" name="version" value={item.version} />
    {editorialFields[kind].map(field=><label>{field.label}{field.key==='fullYoutubeId'?<select name={field.key}><option value="">No full performance</option>{[...new Set([...fullChoices,...(typeof payload.fullYoutubeId==='string'?[payload.fullYoutubeId]:[])])].map(option=><option value={option} selected={payload.fullYoutubeId===option}>{option}</option>)}</select>:field.type==='textarea'||field.type==='lines'?<textarea name={field.key} required={field.required} maxlength="12000">{field.type==='lines'?strings(field.key).join('\n'):String(payload[field.key]??'')}</textarea>:field.type==='choice'&&kind==='youtube-review'&&field.key==='seriesId'?<select name={field.key}><option value="__inherit__" selected={payload.seriesId===undefined}>Use automatic classification</option><option value="__unclassified__" selected={payload.seriesId===null}>Unclassified</option><option value="sessions" selected={payload.seriesId==='sessions'}>Sonic Sessions</option><option value="covers" selected={payload.seriesId==='covers'}>Sonic Covers</option></select>:field.type==='choice'?<select name={field.key}>{field.options!.map(option=><option value={option} selected={String(payload[field.key]??'')===option}>{option||'Unclassified'}</option>)}</select>:field.type==='checkbox'?<input type="checkbox" name={field.key} checked={payload[field.key]===true} />:<input name={field.key} type={field.type} value={String(payload[field.key]??'')} required={field.required} maxlength={field.type==='text'?'1000':undefined} />}</label>)}
    {kind==='site'&&siteCopy&&<>
      <SiteSettingsFields copy={siteCopy} />
      <CommunityPicksFields picks={(payload as SiteConfig).communityPicks} />
      <fieldset><legend>Homepage spotlight and teaser</legend>
        <label>Homepage hero performance<select name="hero.performanceId" required>{heroOptions.map(option=><option value={option.id} selected={selectedHeroId===option.id}>{option.label}</option>)}</select></label>
        <label>Portrait teaser<select name="hero.portraitClipId"><option value="" selected={!selectedClipId}>No teaser</option>{teaserOptions.map(option=><option value={option.id} selected={selectedClipId===option.id}>{option.label}</option>)}</select></label>
        <small>Choose from existing eligible performances and portrait clips. Artwork, poster and video paths follow the selected record.</small>
      </fieldset>
    </>}
    {(kind==='performance'||kind==='youtube-review')&&<EditorialPicker name="artistIds" label="Performing artists" selected={strings('artistIds')} options={options('artist')} />}
    {kind==='site'&&<>{['spotlightPerformanceIds','featuredPerformanceIds','featuredCoverIds','featuredArtistIds'].map(key=><EditorialPicker name={key} label={({spotlightPerformanceIds:'Homepage spotlights (maximum four)',featuredPerformanceIds:'Featured performances',featuredCoverIds:'Featured covers',featuredArtistIds:'Featured artists'})[key]!} selected={strings(key)} options={options(key==='featuredArtistIds'?'artist':'performance')} />)}</>}
    <button disabled={conflict}>Save private draft</button>
    {conflict&&<p><a href={`/admin/content/${id}/`}>Reload the latest revision after copying your changes</a></p>}
  </form>:<p>Media source editing will become available after upload validation is connected. Existing clip sources are preserved.</p>}
  {!isArchived&&<><h2>Review this saved revision</h2><p>Save form changes before submitting or approving. These actions apply to revision {item.version} shown when this page loaded.</p>
  <form method="post"><input type="hidden" name="revision" value={item.draft_revision_id} /><button class="secondary" name="action" value="submit">Submit for review</button>{canReview&&<><button name="action" value="approve">Approve saved revision</button><button class="secondary" name="action" value="request-changes">Request changes</button></>}</form></>}
  <p><a href="/admin/content/">← Content library</a></p>
  <section aria-labelledby="revision-history"><h2 id="revision-history">Saved revision history</h2>
    <p>Newest first, {historyPageSize} per page. Each revision lists what changed from the one before it. Restoring creates a new private draft; it does not change the approved version.</p>
    {history.error?<p role="alert">History could not be loaded. Reload to try again.</p>:history.entries.length===0?<p>No revisions on this page.</p>:<ol>{history.entries.map(revision=><li>
      <strong>Revision {revision.version}</strong> · <time datetime={revision.createdAt}>{new Date(revision.createdAt).toISOString().replace('T',' ').slice(0,16)} UTC</time>
      <details><summary>{revision.first?'First saved revision':revision.changes.length?`${revision.changes.length} change${revision.changes.length===1?'':'s'}`:'No content changes'}</summary>{revision.changes.length>0&&<ul>{revision.changes.map(change=><li><strong>{change.field}</strong>: <del>{change.before}</del> → <ins>{change.after}</ins></li>)}</ul>}</details>
      {['artist','performance','site'].includes(kind)&&<> · <a href={`/preview/${id}/?revision=${revision.id}`} target="_blank" rel="noopener">Preview revision {revision.version} ↗</a>{kind==='site'&&<> · <a href={`/preview/${id}/?revision=${revision.id}&view=about`} target="_blank" rel="noopener">About page</a></>}</>}
      {!isArchived&&revision.id!==item.draft_revision_id&&<form method="post"><input type="hidden" name="action" value="restore" /><input type="hidden" name="revision" value={revision.id} /><input type="hidden" name="version" value={item.version} /><button class="secondary">Restore revision {revision.version} as new draft</button></form>}
    </li>)}</ol>}
    {!history.error&&(historyNumber>1||history.hasMore)&&<p>{historyNumber>1&&<a href={`?history=${historyNumber-1}#revision-history`}>← Newer revisions</a>}{historyNumber>1&&history.hasMore&&' · '}{history.hasMore&&<a href={`?history=${historyNumber+1}#revision-history`}>Older revisions →</a>}</p>}
  </section>
</EditorialLayout>
<script>
  const form=document.querySelector<HTMLFormElement>('[data-editorial-form]');
  if(form){let dirty=false;form.addEventListener('input',()=>{dirty=true});form.addEventListener('change',()=>{dirty=true});form.addEventListener('submit',()=>{dirty=false});window.addEventListener('beforeunload',event=>{if(dirty)event.preventDefault();});}
  document.querySelectorAll<HTMLFormElement>('[data-archive-confirm]').forEach(form=>form.addEventListener('submit',event=>{if(!window.confirm(form.dataset.archiveConfirm??'Continue with this archive action?'))event.preventDefault();}));
</script>

