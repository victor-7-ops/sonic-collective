---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPerformance from '../components/HeroPerformance.astro';
import FeaturedArchive from '../components/FeaturedArchive.astro';
import LatestUploads from '../components/LatestUploads.astro';
import ArtistStrip from '../components/ArtistStrip.astro';
import ClipRail from '../components/ClipRail.astro';
import CommunityPicks from '../components/CommunityPicks.astro';
import { getDiscoveryCatalog } from '../lib/discovery';
import communityPicks from '../data/community-picks.json';
import '../styles/home.css';
const catalog=await getDiscoveryCatalog();
const configuredHero=catalog.performances.find((p)=>p.id===catalog.site.hero.performanceId);
const featured=catalog.site.featuredPerformanceIds.map((id)=>catalog.performances.find((p)=>p.id===id)).filter((p):p is NonNullable<typeof p>=>p!==undefined&&catalog.availability[p.youtubeId]!=='unavailable');
const canEmbed=(youtubeId:string)=>!['unavailable','external-only'].includes(catalog.availability[youtubeId]);
const hero=configuredHero&&canEmbed(configuredHero.youtubeId)?configuredHero:featured.find(p=>canEmbed(p.youtubeId))??configuredHero;
const covers=catalog.site.featuredCoverIds.map((id)=>catalog.performances.find((p)=>p.id===id)).filter((p):p is NonNullable<typeof p>=>p!==undefined&&catalog.availability[p.youtubeId]!=='unavailable');
const nextOptions=[...featured,...covers].filter(performance=>performance.id!==hero?.id).map(performance=>({
  performance,clip:catalog.clips.find(clip=>clip.performanceId===performance.id),
}));
const next=nextOptions.find(option=>option.clip&&canEmbed(option.performance.youtubeId))??nextOptions.find(option=>option.clip)??nextOptions[0];
const featuredArtists=catalog.site.featuredArtistIds.map((id)=>catalog.artists.find((a)=>a.id===id)).filter((a)=>a!==undefined);
const teaserClip=catalog.clips.find((c)=>c.id===catalog.site.hero.portraitClipId);
const appearanceCounts=Object.fromEntries(catalog.artists.map((artist)=>[artist.id,catalog.performances.filter((p)=>catalog.availability[p.youtubeId]!=='unavailable'&&p.artistIds.includes(artist.id)).length]));
const activeSnapshot=catalog.snapshot.initialized&&!catalog.snapshot.purged&&!!catalog.snapshot.expiresAt&&Date.parse(catalog.snapshot.expiresAt)>Date.now();
const itemByVideo=new Map(catalog.catalogItems.map((item)=>[item.youtubeId,item]));
const latest=activeSnapshot?catalog.snapshot.videos.slice().sort((a,b)=>Date.parse(b.publishedAt)-Date.parse(a.publishedAt)||a.youtubeId.localeCompare(b.youtubeId)).flatMap((video)=>{const item=itemByVideo.get(video.youtubeId);return item?[{...item,publishedAt:video.publishedAt}]:[]}).slice(0,6):[];
const playbackRecords=[...catalog.performances.map(({id,title,youtubeId})=>({id,title,youtubeId,embeddable:catalog.availability[youtubeId]!=='unavailable'&&catalog.availability[youtubeId]!=='external-only'})),...catalog.imported.map(({id,title,youtubeId,embeddable})=>({id,title,youtubeId,embeddable}))];
---
<BaseLayout title="Sonic Collective — Independent voices" description="A home for Filipino independent music, featuring Sonic Sessions and Sonic Covers." theme="dark" currentPath="/" playbackRecords={playbackRecords}>
  {hero&&<HeroPerformance performance={hero} site={catalog.site} artistNames={catalog.artists.filter(artist=>hero.artistIds.includes(artist.id)).map(artist=>artist.name)} playable={catalog.availability[hero.youtubeId]!=='unavailable'} embeddable={canEmbed(hero.youtubeId)} next={next} previewClip={teaserClip} />}
  <FeaturedArchive performances={featured.filter(item=>item.id!==hero?.id).slice(0,3)} artists={catalog.artists} availability={catalog.availability} />
  <ArtistStrip artists={featuredArtists} appearanceCounts={appearanceCounts} />
  <LatestUploads items={latest} clips={catalog.clips} />
  <ClipRail clips={catalog.clips} performances={catalog.performances} artists={catalog.artists} />
  <CommunityPicks picks={communityPicks} />
  <section class="closing section"><div class="wrap closing__inner"><h2 class="display">Come for a song.<br />Stay for the voices.</h2><a class="text-link" href="https://www.youtube.com/@Sonic_Collective-PH" target="_blank" rel="noreferrer">Find us on YouTube ↗</a></div></section>
  <script>import '../../scripts/motion.ts'; import '../../scripts/clips.ts';</script>
</BaseLayout>

