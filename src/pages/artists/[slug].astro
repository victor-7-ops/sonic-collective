---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerformanceCard from '../../components/PerformanceCard.astro';
import MediaImage from '../../components/MediaImage.astro';
import { getDiscoveryCatalog } from '../../lib/discovery';
import { artistUrl } from '../../lib/urls';
import '../../styles/discovery.css';
export async function getStaticPaths() {
  const catalog = await getDiscoveryCatalog();
  const visible = new Set(catalog.performances.filter((p)=>catalog.availability[p.youtubeId]!=='unavailable').flatMap((performance) => performance.artistIds));
  return catalog.artists.filter((artist) => visible.has(artist.id)).map((artist) => ({ params: { slug: artist.id }, props: { artistId: artist.id } }));
}
const { artistId } = Astro.props;
const catalog = await getDiscoveryCatalog();
const artist = catalog.artists.find((item) => item.id === artistId)!;
const appearances = catalog.performances.filter((performance) => catalog.availability[performance.youtubeId]!=='unavailable'&&performance.artistIds.includes(artist.id)).sort((a,b) => a.featuredOrder-b.featuredOrder || a.id.localeCompare(b.id));
const title = `${artist.name} | Sonic Collective artists`;
const description = artist.bio ?? `${artist.name} appears in ${appearances.length} Sonic Collective ${appearances.length === 1 ? 'performance' : 'performances'}.`;
---
<BaseLayout title={title} description={description} canonicalPath={artistUrl(artist.id)} currentPath="/artists/" playbackRecords={catalog.performances.map(({id,title,youtubeId})=>({id,title,youtubeId,embeddable:catalog.availability[youtubeId]!=='unavailable'&&catalog.availability[youtubeId]!=='external-only'}))}>
  <article class="discovery-page"><div class="discovery-page__inner">
    <nav aria-label="Breadcrumb"><a href="/artists/">Artists</a> <span aria-hidden="true">/</span> {artist.name}</nav>
    <section class="profile-heading" style="margin-top:28px">
      <MediaImage class="media-frame" base={artist.portrait} alt={artist.portraitAlt} focalPoint={artist.focalPoint} eager />
      <div><p class="eyebrow">{artist.kind === 'group' ? 'Group' : 'Artist'}</p><h1>{artist.name}</h1>
        {artist.aliases.length > 0 && <p class="profile-heading__aliases">Also known as {artist.aliases.join(', ')}</p>}
        {artist.bio && <p class="discovery-lede">{artist.bio}</p>}
        {artist.links.length > 0 && <nav class="artist-external-links" aria-label={`${artist.name} verified links`}>{artist.links.map((link) => <a class="button button--quiet" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</nav>}
      </div>
    </section>
    <section class="profile-appearances"><h2>Performances</h2><div class="catalog-grid">{appearances.map((performance) => <PerformanceCard performance={performance} artistNames={performance.artistIds.map((id) => catalog.raw.artists.find((item) => item.id === id)?.name ?? '').filter(Boolean)} playable={catalog.availability[performance.youtubeId]!=='external-only'} />)}</div></section>
  </div></article>
</BaseLayout>
