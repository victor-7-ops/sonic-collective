---
import ArtistPage from '../../components/ArtistPage.astro';
import {getDiscoveryCatalog} from '../../lib/discovery';
export async function getStaticPaths(){const catalog=await getDiscoveryCatalog();return catalog.artists.map(item=>({params:{slug:item.id},props:{artistId:item.id}}));}
const catalog=await getDiscoveryCatalog();
---
<ArtistPage catalog={catalog} artistId={Astro.props.artistId} />
