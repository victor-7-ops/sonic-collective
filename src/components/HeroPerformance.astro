---
import type { Clip, Performance, SiteConfig } from '../lib/schemas';
import MediaImage from './MediaImage.astro';
import { youtubeUrl } from '../lib/urls';
interface Props { performance: Performance; site: SiteConfig; artistNames: string[]; playable: boolean; embeddable: boolean; previewClip?: Clip; next?: { clip?: Clip; performance: Performance }; }
const {performance,site,artistNames,playable,embeddable,next,previewClip}=Astro.props;
const loopSrc = previewClip?.performanceId === performance.id ? site.hero.portraitLoopSrc : undefined;
---
<section class="hero" aria-labelledby={`hero-title-${performance.id}`} data-teaser-clip={loopSrc ? previewClip?.id : undefined}>
  <div class="hero__layout wrap">
    <div class="hero__copy">
      <p class="eyebrow hero__cue">Independent voices. Shared frequencies.</p>
      <h1 class="display hero__title" id={`hero-title-${performance.id}`}>SONIC<br />COLLECTIVE</h1>
      <p class="hero__intro">A space for the voices you know.<br />And the ones you’re about to discover.</p>
      <a class="hero__watch" href={playable?youtubeUrl(performance.youtubeId):site.channelUrl} data-play-performance={embeddable?performance.id:undefined}><span aria-hidden="true">▶</span><span>{playable?'Watch performance':'Visit our channel'}</span></a>
    </div>
    <div class="hero__spotlight">
      <div class="hero__feature performance-player__poster" data-teaser-surface data-player-id={performance.id} data-video-id={performance.youtubeId}>
      <MediaImage class="hero__image" base={performance.id===site.hero.performanceId?site.hero.poster:performance.thumbnail} alt={performance.thumbnailAlt} sizes="(max-width: 760px) 100vw, 64vw" eager={true} />
      {loopSrc&&<video class="hero__loop" data-teaser-video data-src={loopSrc} muted playsinline preload="none" hidden aria-label="Silent performance preview"></video>}

      </div>
      <p class="eyebrow hero__label">In the spotlight</p>
      <h2 class="hero__artist">{artistNames.join(' & ')} <span>/ {performance.title}</span></h2>
      {embeddable&&<p class="performance-player__status" data-player-status role="status"></p>}
      {embeddable&&<a class="text-link" href={youtubeUrl(performance.youtubeId)}>Watch on YouTube <span aria-hidden="true">↗</span></a>}
      {next&&embeddable&&<section class="hero__up-next" data-playback-teaser aria-label="Up next" hidden>
        <h2>Up next</h2>
        <p>{next.performance.title}</p>
        {next.clip&&<>
          <video class="hero__up-next-video" src={next.clip.src} poster={next.clip.poster} preload="none" playsinline aria-label={`Teaser for ${next.performance.title}`}></video>
          <button type="button" class="button button--quiet" data-play-teaser>Play teaser</button>
        </>}
        <a class="text-link" href={youtubeUrl(next.performance.youtubeId)}>Watch full performance ↗</a>
      </section>}
    </div>
  </div>
</section>
<script>
  import { mediaCoordinator } from '../lib/media-coordinator';

  const teaser = document.querySelector('[data-playback-teaser]');
  const video = teaser?.querySelector('video');
  const play = teaser?.querySelector<HTMLButtonElement>('[data-play-teaser]');
  if (video && play) {
    const owner = 'up-next-teaser';
    let stopTimer: number | undefined;
    const stop = () => {
      window.clearTimeout(stopTimer);
      video.pause();
      play.hidden = false;
      mediaCoordinator.release(owner);
    };
    const start = async (automatic: boolean) => {
      play.disabled = true;
      mediaCoordinator.claim(owner, stop);
      try {
        if (mediaCoordinator.getActiveOwner() !== owner) return;
        video.muted = automatic;
        video.currentTime = 0;
        await video.play();
        if (mediaCoordinator.getActiveOwner() !== owner) return;
        play.hidden = true;
        if (automatic) stopTimer = window.setTimeout(stop, 4500);
      } catch {
        stop();
        if (!automatic) play.textContent = 'Tap to play teaser';
      } finally {
        play.disabled = false;
      }
    };
    play.addEventListener('click', () => void start(false));
    teaser?.closest('.hero')?.addEventListener('spotlight-ended', () => {
      if (document.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      void start(true);
    });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    video.addEventListener('timeupdate', () => { if (video.currentTime >= 8) stop(); });
    video.addEventListener('ended', stop);
  }
</script>
