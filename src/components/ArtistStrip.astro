---
import type { Artist } from '../lib/schemas';
import ArtistCard from './ArtistCard.astro';
interface Props { artists: Artist[]; appearanceCounts: Record<string,number>; }
const {artists,appearanceCounts}=Astro.props;
---
<section class="artists section" aria-labelledby="artists-title" data-reveal>
  <div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">Meet the collective</p><h2 class="section-title" id="artists-title">Many voices. One shared space.</h2></div><a class="text-link" href="/artists/">Meet the artists <span aria-hidden="true">↗</span></a></div>
    <div class="artists__controls"><button type="button" data-rail-prev="artists" aria-label="Scroll artists backward">← Previous</button><button type="button" data-rail-next="artists" aria-label="Scroll artists forward">Next →</button></div>
    <div class="artists__rail" data-rail="artists">{artists.map((artist)=><div class="artists__item"><ArtistCard artist={artist} appearanceCount={appearanceCounts[artist.id]??0} /></div>)}</div>
  </div>
</section>
