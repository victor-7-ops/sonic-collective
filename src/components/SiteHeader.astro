---
import type { SiteHeader as SiteHeaderCopy } from '../lib/schemas';
interface Props { theme?: 'light'|'dark'; currentPath?: string; header:SiteHeaderCopy; channelUrl:string; }
const {theme='light',currentPath='',header,channelUrl}=Astro.props;
const links: [string,string][]=[[header.performancesLabel,'/sessions/'],[header.artistsLabel,'/artists/'],[header.aboutLabel,'/about/']];
---
<header class:list={['site-header',theme==='dark'&&'site-header--overlay']}>
  <div class="site-header__inner wrap">
    <a class="brand" href="/" aria-label="Sonic Collective home">
      <img class="brand__logo" src={theme==='dark'?'/media/brand/sonic-collective-logo-white.png':'/media/brand/sonic-collective-logo.png'} alt="" width="60" height="78" />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <button class="site-nav__toggle" type="button" aria-expanded="true" aria-controls="site-nav-panel">{header.exploreLabel} <span aria-hidden="true">⌄</span></button>
      <div class="site-nav__links" id="site-nav-panel" data-expanded="true">
        {links.map(([label,href])=><a href={href} aria-current={currentPath===href?'page':undefined}>{label}</a>)}
        <a class="site-nav__youtube" href={channelUrl} target="_blank" rel="noreferrer">{header.youtubeLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </div>
</header>


