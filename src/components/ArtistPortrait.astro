---
import type { Artist } from '../lib/schemas';
import MediaImage from './MediaImage.astro';
interface Props { artist: Artist; eager?: boolean; }
const {artist,eager=false}=Astro.props;
---
{artist.portrait
  ? <MediaImage class="artist-card__image media-frame" base={artist.portrait} alt={artist.portraitAlt??artist.name} focalPoint={artist.focalPoint} eager={eager} />
  : <div class="artist-card__image artist-initials media-frame" aria-hidden="true">{artist.name.split(' ').slice(0,2).map(word=>word[0]).join('')}</div>}
<style>
.artist-initials { display:grid; place-items:center; width:100%; aspect-ratio:16/9; background:#203a34; color:#f3f1e9; font-size:clamp(36px,6vw,72px); font-weight:700; letter-spacing:.06em; }
</style>
