---
import type { Artist, Clip, Performance } from '../lib/schemas';
import PerformanceCard from './PerformanceCard.astro';
interface Props { performances: Performance[]; artists: Artist[]; availability:Record<string,string>; clips: Clip[]; }
const {performances,artists,availability,clips}=Astro.props;
const names=(p:Performance)=>p.artistIds.map(id=>artists.find(a=>a.id===id)?.name??'').filter(Boolean);
---
<section class="covers section" aria-labelledby="covers-title" data-reveal>
  <div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">Sonic Covers / familiar songs, individual voices</p><h2 class="section-title" id="covers-title">A different kind of cover.</h2></div><a class="text-link" href="/sessions/?series=covers">Explore covers <span aria-hidden="true">↗</span></a></div>
    <div class="covers__controls"><button type="button" data-rail-prev="covers" aria-label="Scroll covers backward">← Previous</button><button type="button" data-rail-next="covers" aria-label="Scroll covers forward">Next →</button></div>
    <div class="covers__rail" data-rail="covers">
      {performances.map((performance)=><div class="covers__item"><PerformanceCard performance={performance} artistNames={names(performance)} playable={availability[performance.youtubeId]!=='external-only'} preview={clips.find((clip)=>clip.performanceId===performance.id)} /></div>)}
    </div>
  </div>
</section>
