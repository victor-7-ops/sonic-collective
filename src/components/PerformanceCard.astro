---
import type { Performance } from '../lib/schemas';
import type { Clip } from '../lib/schemas';
import MediaImage from './MediaImage.astro';
import PerformancePreview from './PerformancePreview.astro';
interface Props { performance: Performance; artistNames: string[]; playable?:boolean; preview?: Clip; }
const {performance,artistNames,playable=true,preview}=Astro.props;
const href=`/sessions/${encodeURIComponent(performance.id)}/`;
---
<article class="performance-card">
  <div class="performance-card__media">
    <a class="card-link" href={href} aria-label={`${performance.title} by ${artistNames.join(' and ')}`}>
      <MediaImage class="performance-card__image media-frame" base={performance.thumbnail} alt={performance.thumbnailAlt} />
      <span class="session-stamp" aria-hidden="true">SC SESSION</span>
    </a>
    {preview&&<PerformancePreview clip={preview} label={`${performance.title} by ${artistNames.join(' and ')}`} />}
  </div>
  <div class="performance-card__body">
    <div class="performance-card__meta"><h2 class="performance-card__title"><a class="card-link" href={href}>{artistNames.join(' & ')||'Artist'}</a></h2><small>{performance.seriesId==='sessions'?'Session':'Cover'}</small></div>
    <div class="performance-card__meta"><a href={href}>{performance.title}</a>{performance.episode&&<small>Ep. {String(performance.episode).padStart(2,'0')}</small>}</div>
    {playable&&<button class="performance-card__quick-watch" type="button" data-watch-id={performance.id} hidden aria-label={`Quick watch ${performance.title}`}>Quick watch</button>}
  </div>
</article>
