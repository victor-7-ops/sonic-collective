---
import type { Artist, Clip, Performance } from '../lib/schemas';
import PerformanceCard from './PerformanceCard.astro';
interface Props { performances: Performance[]; artists: Artist[]; availability:Record<string,string>; clips: Clip[]; }
const {performances,artists,availability,clips}=Astro.props;
const filters=[['all','All performances'],['sessions','Sonic Sessions'],['covers','Sonic Covers']];
const names=(p:Performance)=>p.artistIds.map(id=>artists.find(a=>a.id===id)?.name??'').filter(Boolean);
---
<section class="archive section" aria-labelledby="archive-title" data-featured-archive data-reveal>
  <div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">The performance archive</p><h2 class="section-title" id="archive-title">Find your next favorite.</h2></div><a class="text-link" href="/sessions/">All performances <span aria-hidden="true">↗</span></a></div>
    <div class="archive__filters" aria-label="Filter featured performances">
      {filters.map(([value,label],index)=><button type="button" data-featured-filter={value} aria-pressed={index===0?'true':'false'}>{label}</button>)}
    </div>
    <p role="status" data-featured-count>{performances.length} performances shown</p>
    <p data-featured-empty hidden>No featured performances in this series. Choose All performances to reset the filter.</p>
    <div class="archive__grid">
      {performances.map((performance)=><div class="archive__item" data-featured-item data-series={performance.seriesId}><PerformanceCard performance={performance} artistNames={names(performance)} playable={availability[performance.youtubeId]!=='external-only'} preview={clips.find((clip)=>clip.performanceId===performance.id)} /></div>)}
    </div>
  </div>
</section>
