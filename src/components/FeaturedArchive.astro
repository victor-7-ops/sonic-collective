---
import type { Artist, Performance } from '../lib/schemas';
import PerformanceCard from './PerformanceCard.astro';

interface Props { performances: Performance[]; artists: Artist[]; availability: Record<string, string>; }
const { performances, artists, availability } = Astro.props;
---
<section class="archive section" aria-labelledby="archive-title">
  <div class="wrap">
    <div class="section-heading">
      <div><p class="eyebrow">From the archive</p><h2 class="section-title" id="archive-title">Selected performances</h2></div>
      <a class="text-link" href="/sessions/">All performances <span aria-hidden="true">↗</span></a>
    </div>
    <div class="archive__grid">
      {performances.map((performance) => <PerformanceCard performance={performance} artistNames={artists.filter(artist=>performance.artistIds.includes(artist.id)).map(artist=>artist.name)} playable={availability[performance.youtubeId]!=='external-only'} />)}
    </div>
  </div>
</section>
