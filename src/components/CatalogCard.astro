---
import type { CatalogItem } from '../lib/discovery';
import type { Clip } from '../lib/schemas';
import artists from '../data/artists.json';
import { artistUrl } from '../lib/urls';
import MediaImage from './MediaImage.astro';
import RemoteThumbnail from './RemoteThumbnail.astro';
import PerformancePreview from './PerformancePreview.astro';
interface Props { item:CatalogItem; preview?: Clip; }
const {item,preview}=Astro.props;
---
<article class="performance-card">
  <div class="performance-card__media">
    <a class="card-link" href={item.href} aria-label={item.artistLabel?`${item.title} by ${item.artistLabel}`:item.title}>
      {item.image.kind==='local'?<MediaImage class="performance-card__image media-frame" base={item.image.base} alt={item.image.alt} />:<RemoteThumbnail class="performance-card__image media-frame" url={item.image.url} alt={item.image.alt} />}
      {item.source==='curated'&&<span class="session-stamp" aria-hidden="true">SC SESSION</span>}
    </a>
    {preview&&<PerformancePreview clip={preview} label={item.title} />}
  </div>
  <div class="performance-card__body">
    <div class="performance-card__meta"><h2 class="performance-card__title"><a class="card-link" href={item.href}>{item.artistLabel??'Sonic Collective'}</a></h2><small>{item.format==='short'?'Short':item.format==='full'?'Full performance':'Upload'}</small></div>
    {item.artistIds.length>0&&<p class="catalog-artists">{item.artistIds.map(id=><a href={artistUrl(id)}>{artists.find(artist=>artist.id===id)?.name} ↗</a>)}</p>}
    <div class="performance-card__meta"><small>{item.seriesId==='sessions'?'Session':item.seriesId==='covers'?'Cover':'Latest upload'}</small></div>
    <div class="performance-card__meta"><a href={item.href}>{item.title}</a></div>
    {item.fullPerformance&&<a class="text-link" href={item.fullPerformance.href}>Watch full performance ↗</a>}
    {item.embeddable&&<button class="performance-card__quick-watch" type="button" data-watch-id={item.id} hidden aria-label={`Quick watch ${item.title}`}>Quick watch</button>}
  </div>
</article>
